<script>
  // The dashboard - the whole gated half of the app in one page. Two
  // forms, both progressive-enhancement honest:
  //
  //   with JS    - the handlers fetch-POST to the api routes and
  //                refresh() the page in place: one request, no reload
  //   without JS - the login form posts natively (the cookie is set, the
  //                next visit shows the manager); the write forms are the
  //                JS path, which is the honest split for a backoffice
  //
  // The wall is NOT here: without a session the middleware loads no user,
  // so this page renders the login form and nothing else. `signedIn` is UX
  // only - it remembers in this tab that the login fetch succeeded, because
  // an HttpOnly cookie is deliberately unreadable from JavaScript.
  interface Item { id: number; label: string }

  let signedIn = $state(false);
  let error = $state('');

  let user = $data(async () => getContext().user ?? null);
  let items = $data(async (): Promise<Item[] | null> =>
    getContext().items ?? (signedIn() && typeof location !== 'undefined' ? (await (await fetch('/api/items')).json()).items : null));

  async function login(e: SubmitEvent) {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const res = await fetch('/api/login', { method: 'POST', body: new FormData(form) });
    if (res.ok) { signedIn(true); error(''); } else { error('wrong user or password'); }
  }

  async function create(e: SubmitEvent) {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const res = await fetch('/api/items', { method: 'POST', body: new FormData(form) });
    if (res.ok) { error(''); form.reset(); await refresh(); } else { error(await res.text()); }
  }

  async function remove(id: number) {
    const res = await fetch('/api/items?id=' + id, { method: 'DELETE' });
    if (res.ok) await refresh(); else { error(await res.text()); }
  }

  // Sign out is a DELETE, which a native form cannot send - so it is the
  // one action that needs the client. The cookie expires in 7 days anyway,
  // and the README says so plainly.
  async function logout() {
    await fetch('/api/login', { method: 'DELETE' });
    signedIn(false);
    await refresh();
  }
</script>

<h1>Dashboard</h1>

{#if signedIn() || user()}
  <p>Signed in as <strong>admin</strong>. <button on:click={logout}>Sign out</button></p>
  {#if error()}<p><strong>{error()}</strong></p>{/if}

  <form on:submit={create}>
    <input name="label" placeholder="New item" aria-label="New item" required>
    <button type="submit">Add</button>
  </form>

  <ul>
    {#each items() ?? [] as it}
      <li>{it.label} <button on:click={() => remove(it.id)}>delete</button></li>
    {/each}
  </ul>
{/if}

{#if !signedIn() && !user()}
  <p>Sign in to manage. The demo account is <code>admin</code> / <code>admin</code>.</p>
  {#if error()}<p><strong>{error()}</strong></p>{/if}
  <form method="POST" action="/api/login" on:submit={login}>
    <input name="user" placeholder="User" aria-label="User" required>
    <input name="pass" type="password" placeholder="Password" aria-label="Password" required>
    <button type="submit">Sign in</button>
  </form>
{/if}
