<script>
  // The resource. $store is the right shape for an API template: one box
  // per name, shared by every request in the process, and broadcast to the
  // other cluster workers on a write (a plain module object would live in
  // exactly one worker - items would appear and vanish by which core
  // answered). A real service swaps the store body for a database; the
  // handlers below do not change.
  export const store = $store('items', [
    { id: 1, label: 'first' },
    { id: 2, label: 'second' },
  ]);

  const json = (obj: unknown, status = 200) =>
    new Response(JSON.stringify(obj), { status, headers: { 'content-type': 'application/json' } });

  const signedIn = (req: Request) => $cookies(req).session === '1';

  // Public read. The CSRF guard on `rosefn serve` only refuses cross-site
  // WRITES, so a GET needs no token of its own.
  export function GET() {
    return { items: store.get() };
  }

  // Create: 401 without a session, 400 without a label, 201 with the new
  // row. The response is the row, not the whole list - the client already
  // has the list, and a real service would return even less.
  export async function POST(req: Request) {
    if (!signedIn(req)) return json({ error: 'sign in first' }, 401);
    const form = await req.formData();
    const label = String(form.get('label') ?? '').trim();
    if (!label) return json({ error: 'label is required' }, 400);
    const items = store.get();
    const id = items.reduce((max, it) => Math.max(max, it.id), 0) + 1;
    store.set([...items, { id, label }]);
    return json({ id, label }, 201);
  }

  // Delete by ?id=. Same wall as POST.
  export async function DELETE(req: Request) {
    if (!signedIn(req)) return json({ error: 'sign in first' }, 401);
    const id = Number(new URL(req.url).searchParams.get('id'));
    if (!id) return json({ error: 'id is required' }, 400);
    store.set(store.get().filter((it) => it.id !== id));
    return json({ deleted: id });
  }
</script>
