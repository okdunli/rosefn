<script>
  let name = $state('');
  let subscribed = $state(false);
  let plan = $state('free');
  let colors = $state([]);
  let lastKey = $state('');
  function clear() { $setState('name', ''); }
  // F17: keydown is NOT one of the delegated four (click/input/change/submit),
  // so this handler only runs because wire() binds it directly on the input.
  function noteKey(e) { $setState('lastKey', e.key || ''); }
  // F18: |window moves the binding off the element onto window itself
  // (Escape-to-close, scroll, resize) - keyup so it cannot cross-talk with
  // the keydown assertion above.
  let winKey = $state('');
  function noteWinKey(e) { $setState('winKey', e.key || ''); }
</script>

<div class="bind-demo">
  <h1>Two-way binding demo</h1>
  <input bind:value={name} placeholder="Type your name">
  <p>Hello {name() || 'stranger'}!</p>
  <label>
    <input type="checkbox" bind:checked={subscribed}>
    Subscribe
  </label>
  <p>{subscribed() ? 'Subscribed' : 'Not subscribed'}</p>
  <fieldset>
    <legend>Plan</legend>
    <label><input type="radio" name="plan" value="free" bind:group={plan}> Free</label>
    <label><input type="radio" name="plan" value="pro" bind:group={plan}> Pro</label>
  </fieldset>
  <p>Plan: {plan}</p>
  <fieldset>
    <legend>Colors</legend>
    <label><input type="checkbox" value="red" bind:group={colors}> Red</label>
    <label><input type="checkbox" value="green" bind:group={colors}> Green</label>
  </fieldset>
  <p>Colors: {colors().join(', ') || 'none'}</p>
  <select bind:value={plan}>
    <option value="free">Free plan</option>
    <option value="pro">Pro plan</option>
  </select>
  <button on:click={clear}>Clear</button>
  <input class="key-probe" on:keydown={noteKey} placeholder="press a key">
  <p>Last key: {lastKey() || 'none'}</p>
  <div class="win-probe" on:keyup|window={noteWinKey}></div>
  <p>Win key: {winKey() || 'none'}</p>
</div>
