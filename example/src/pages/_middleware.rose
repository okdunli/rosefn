<script>
  // The request interceptor: runs before every render on the server -
  // pages, POSTs and api calls alike. Returning a Response short-circuits
  // the whole request (a redirect, an auth wall, a rewrite); returning
  // nothing continues, and getContext() hands this request's bag to $data,
  // server actions and api handlers. This is the middleware job -
  // in one file, with the
  // same Web-standard Request the edge adapter passes.
  export async function handle(request) {
    const { pathname } = new URL(request.url);
 // $cookies(request) parses the Cookie header ; to SET one, use
    // $sessionCookie(name, value) - HttpOnly + SameSite=Lax by default.
    const session = $cookies(request).session;
    // a thorn: /admin and /vault are walled off without a session cookie.
    // /admin is the deep wall: its page reads getContext(), so the gated
    // content is $data - even a static deploy (the Go binary) shows only
    // the public shell. /vault is the plain wall: its content is public,
    // the gate lives entirely here - which is why the build must never
    // bake it (a cookie-less request is walled, so the route is not static)
    if ((pathname === '/admin' || pathname === '/vault') && !session) {
      return new Response(null, { status: 302, headers: { location: '/sign' } });
    }
 // i18n negotiation: /about with a REAL Accept-Language
    // preference redirects to the visitor's language version - the
    // locale-detection / i18n job, in the middleware the framework
    // already runs. No preference (absent, or the * wildcard Node's own
    // fetch sends) -> the plain page renders; a preference that matches no
    // dictionary serves the default locale in place. Vary keeps caches
    // honest: one language's redirect must never be served to another.
    const best = bestLocale(request.headers.get('accept-language'));
    if (pathname === '/about' && best) {
      return new Response(null, { status: 302, headers: { location: '/' + best + '/about', vary: 'Accept-Language' } });
    }
    // Server-side data loading for the dynamic half: /feed's rows are read
    // HERE, in the one module the compiler never ships to the browser. A
    // page's $data body DOES ship (it re-runs on client-side navigation),
    // so a database import inside a page would land in the client bundle
    // and break the build - the middleware is where server-only data
    // loading lives. Gated by pathname: the query runs for the route that
    // needs it, not on every request in the app. node:sqlite is imported
    // lazily for the same reason as in the api routes: the edge adapter
    // loads this bundle too, and a static node: import would boot-crash
    // the whole app there instead of failing this one route.
    if (pathname === '/feed') {
      feedConn ??= await openFeed();
      getContext().posts = feedConn.prepare('SELECT id, title, author FROM posts ORDER BY id DESC LIMIT 20').all();
    }
    // the rest of the request sees who is asking
    getContext().user = session ? { name: session } : null;
  }

  // The feed's connection, opened once per process (the same lazy pattern
  // as the api routes): this module lives for the server's whole life.
  let feedConn = null;
  const openFeed = async () => {
    const { DatabaseSync } = await import('node:sqlite');
    const db = new DatabaseSync('blog.db');
    db.exec(`CREATE TABLE IF NOT EXISTS posts (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      title TEXT NOT NULL,
      body TEXT NOT NULL,
      author TEXT NOT NULL DEFAULT 'anonymous'
    );`);
    return db;
  };
</script>
