<script>
 // This route opts into a NONCE policy instead of the hashed one.
  // The default policy is a sha256 over the exact bytes of the framework's
  // own bundle - perfect for a self-contained page, and useless the moment
  // the page needs to run someone else's script: the hash cannot name code
  // the app does not ship. A nonce is minted per response, the header and
  // every inline script in the document carry the same value, and
  // 'strict-dynamic' lets those trusted scripts pull in more.
  export const csp = { nonce: true };

  // The page itself is still an ordinary rosespan page: state, events, the
  // one-request contract. The third-party machinery lives entirely in the
  // <head> below.
  let clicks = $state(0);
</script>

<style>
  :global(*), :global(*::before), :global(*::after) { box-sizing: border-box; }
  :global(:root) {
    --bg: #faf9f8; --surface: #ffffff; --text: #201d1a; --muted: #6f6a63;
    --border: #e8e4de; --accent: #d6336c; --accent-strong: #b02a5b; --code-bg: #f3f1ee;
    --shadow: 0 1px 2px rgba(28, 25, 23, .05), 0 10px 30px -12px rgba(28, 25, 23, .12);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root) {
      --bg: #171412; --surface: #201c19; --text: #ece8e3; --muted: #a29b91;
      --border: #322d28; --accent: #ff5c8a; --accent-strong: #ff7ea3; --code-bg: #262220;
      --shadow: 0 1px 2px rgba(0, 0, 0, .4), 0 10px 30px -12px rgba(0, 0, 0, .5);
    }
  }
  :global(html) { -webkit-text-size-adjust: 100%; }
  :global(body) {
    margin: 0; padding: 2rem 1.25rem 3rem; background: var(--bg); color: var(--text);
    font: 16px/1.65 system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }
  :global(main) { max-width: 44rem; margin: 0 auto; }
  :global(a) { color: var(--accent); text-decoration: none; font-weight: inherit; }
  :global(a:hover) { text-decoration: underline; }
  :global(h1) { font-size: 1.9rem; line-height: 1.25; letter-spacing: -0.02em; margin: 0 0 .5rem; }
  :global(p) { margin: .5rem 0; }
  :global(.meta) { color: var(--muted); font-size: .85rem; }
  :global(code) {
    background: var(--code-bg); border: 1px solid var(--border); border-radius: 5px;
    padding: .1em .35em; font-size: .875em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  :global(.card) {
    background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
    box-shadow: var(--shadow); padding: 1.4rem 1.5rem; margin: 0 0 1.25rem;
  }
  :global(.card > :first-child) { margin-top: 0; }
  :global(.card > :last-child) { margin-bottom: 0; }
  :global(.btn) {
    display: inline-block; background: var(--accent); color: #fff; border: 0; border-radius: 8px;
    padding: .55rem 1.1rem; font: inherit; font-weight: 600; font-size: .95rem; cursor: pointer;
  }
  :global(.btn:hover) { background: var(--accent-strong); color: #fff; text-decoration: none; }
</style>

<head>
  <title>Third-party scripts, the rosespan shape</title>

  <!-- 1. the Partytown config: an INLINE script. Under a nonce policy the
       browser blocks every inline script that does not carry the nonce -
       and rosespan stamps the route's head scripts with the same value the
       CSP header carries, so this one runs. -->
  <script>
    window.partytown = {
      lib: '/_partytown/',           // where the lib is served from
      forward: ['dataLayer.push'],   // which calls move to the worker
    };
  </script>

  <!-- 2. the lib itself: an EXTERNAL script. The nonce rides this tag too
       (the framework stamps every script in the head), so the policy admits
       it. Serve it from your own origin - a static file in public/ is the
       honest way - and it costs one request that the browser caches. -->
  <script src="/vendor/partytown.js"></script>

  <!-- 3. the analytics snippet: NOT executed by the browser. Partytown's lib
       reads these blocks and runs them in a web worker, so the main thread
       never blocks on a third-party origin. A `text/partytown` block needs
       no nonce - the browser never executes it. -->
  <script type="text/partytown" src="https://www.googletagmanager.com/gtag/js?id=G-MEASUREMENT-ID"></script>
  <script type="text/partytown">
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-MEASUREMENT-ID');
  </script>
</head>

<main>
<div class="card">
  <h1>🌹 Third-party scripts, the rosespan shape</h1>
  <p>
    This page runs a strict CSP with no <code>unsafe-inline</code> — and still
    loads a third-party analytics library, off the main thread, through
    Partytown. The route's own code is ordinary rosespan: one request, zero
    hydration, the same single document.
  </p>
  <p>App interactions still work: <button class="btn" on:click={() => $setState('clicks', clicks() + 1)}>click</button> <strong>{clicks()}</strong></p>
  <p class="meta">
    View source: every inline <code>&lt;script&gt;</code> in the head carries the
    same <code>nonce</code> as the <code>Content-Security-Policy</code> header —
    that is the whole mechanism.
  </p>
</div>
</main>
