<script>
  // The landing page: a working client for the two endpoints. The fetch
  // path is the JS one; the curl lines in the README are the no-JS one -
  // an api is the same api either way.
  let result = $state('');
  let error = $state('');

  async function call(path: string, init?: RequestInit) {
    error('');
    const res = await fetch(path, init);
    const text = await res.text();
    if (res.ok) { result(text); } else { result(''); error(`${res.status} ${text}`); }
  }

  async function signIn(e: SubmitEvent) {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const res = await fetch('/api/token', { method: 'POST', body: new FormData(form) });
    if (!res.ok) { error(`${res.status} ${await res.text()}`); result(''); return; }
    const body = await res.json();
    (form.querySelector('[name=token]') as HTMLInputElement).value = body.access_token;
    error('');
  }

  async function whoami(e: SubmitEvent) {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const token = String(new FormData(form).get('token') ?? '');
    await call('/api/me', { headers: { authorization: `Bearer ${token}` } });
  }
</script>

<style>
  :global(*), :global(*::before), :global(*::after) { box-sizing: border-box; }
  :global(:root) {
    --bg: #faf9f8; --surface: #ffffff; --text: #201d1a; --muted: #6f6a63;
    --border: #e8e4de; --accent: #d6336c; --accent-strong: #b02a5b; --accent-soft: #fdf2f6;
    --danger: #c92a2a; --code-bg: #f3f1ee;
    --shadow: 0 1px 2px rgba(28, 25, 23, .05), 0 10px 30px -12px rgba(28, 25, 23, .12);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root) {
      --bg: #171412; --surface: #201c19; --text: #ece8e3; --muted: #a29b91;
      --border: #322d28; --accent: #ff5c8a; --accent-strong: #ff7ea3; --accent-soft: #2b1a20;
      --danger: #ff8787; --code-bg: #262220;
      --shadow: 0 1px 2px rgba(0, 0, 0, .4), 0 10px 30px -12px rgba(0, 0, 0, .5);
    }
  }
  :global(html) { -webkit-text-size-adjust: 100%; }
  :global(body) {
    margin: 0; padding: 2rem 1.25rem 3rem; background: var(--bg); color: var(--text);
    font: 16px/1.65 system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }
  :global(main) { max-width: 44rem; margin: 0 auto; }
  :global(a) { color: var(--accent); text-decoration: none; font-weight: inherit; }
  :global(a:hover) { text-decoration: underline; }
  :global(h1) { font-size: 1.9rem; line-height: 1.25; letter-spacing: -0.02em; margin: 0 0 .5rem; }
  :global(h2) { font-size: 1.2rem; letter-spacing: -0.01em; margin: 0 0 .5rem; }
  :global(p) { margin: .5rem 0; }
  :global(.lede) { color: var(--muted); font-size: 1.02rem; margin-bottom: 1.5rem; }
  :global(code) {
    background: var(--code-bg); border: 1px solid var(--border); border-radius: 5px;
    padding: .1em .35em; font-size: .875em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  :global(pre) {
    background: var(--code-bg); border: 1px solid var(--border); border-radius: 10px;
    padding: .9rem 1rem; overflow-x: auto; font-size: .85rem; line-height: 1.55; margin: .75rem 0;
  }
  :global(pre code) { background: none; border: 0; padding: 0; }
  :global(.card) {
    background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
    box-shadow: var(--shadow); padding: 1.4rem 1.5rem; margin: 0 0 1.25rem;
  }
  :global(.card > :first-child) { margin-top: 0; }
  :global(.card > :last-child) { margin-bottom: 0; }
  :global(.btn) {
    display: inline-block; background: var(--accent); color: #fff; border: 0; border-radius: 8px;
    padding: .55rem 1.1rem; font: inherit; font-weight: 600; font-size: .95rem; cursor: pointer;
  }
  :global(.btn:hover) { background: var(--accent-strong); color: #fff; text-decoration: none; }
  :global(.btn-ghost) { background: transparent; color: var(--accent); border: 1px solid var(--border); }
  :global(.btn-ghost:hover) { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }
  :global(input) {
    width: 100%; font: inherit; color: var(--text); background: var(--surface);
    border: 1px solid var(--border); border-radius: 8px; padding: .55rem .75rem; margin: 0 0 .8rem;
  }
  :global(input:focus) { outline: 2px solid var(--accent); outline-offset: 1px; border-color: var(--accent); }
  :global(.error) { color: var(--danger); font-weight: 600; }
  @media (max-width: 560px) {
    :global(h1) { font-size: 1.5rem; }
    :global(.card) { padding: 1.1rem 1.15rem; }
  }
</style>

<head>
  <title>JWT, the rosespan shape</title>
</head>

<main>
  <h1>🌹 JWT, the rosespan shape</h1>
  <p class="lede">
    Two endpoints: <code>POST /api/token</code> mints, <code>GET /api/me</code>
    verifies. HS256 over Web Crypto — no library, no <code>node:</code> import,
    and the same bundle runs on Node, the edge and a serverless function.
  </p>

  <form class="card" on:submit={signIn}>
    <h2>Mint a token</h2>
    <input name="user" placeholder="user" aria-label="user" value="ada">
    <input name="pass" type="password" placeholder="pass" aria-label="pass" value="lovelace">
    <button class="btn" type="submit">Get a token</button>
  </form>

  <form class="card" on:submit={whoami}>
    <h2>Verify</h2>
    <input name="token" placeholder="paste a token" aria-label="token">
    <button class="btn btn-ghost" type="submit">Who am I?</button>
  </form>

  {#if error()}<p class="error">{error()}</p>{/if}
  {#if result()}<pre>{result()}</pre>{/if}
</main>
